# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 커밋되지 않습니다)
#   cp .env.example .env

# ---------- 앱 ----------
APP_NAME=카카오 방명록
# 세션 쿠키 서명 키. 운영에서는 반드시 긴 임의 문자열로 바꾸세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./guestbook.db
# HTTPS로 서비스하면 true (세션 쿠키에 Secure 속성)
SESSION_HTTPS_ONLY=false

# ---------- 카카오 로그인 (https://developers.kakao.com) ----------
KAKAO_REST_API_KEY=
# [카카오 로그인 > 보안]에서 Client Secret을 '사용함'으로 설정한 경우에만 입력
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback
