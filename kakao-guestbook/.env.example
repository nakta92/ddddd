# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 Git에 커밋되지 않습니다)
#   cp .env.example .env

# ---------- 앱 ----------
APP_NAME=카카오 방명록
# 세션 쿠키 서명 키. 운영에서는 반드시 긴 임의 문자열로 바꾸세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./guestbook.db
# HTTPS로 서비스하면 true (세션 쿠키에 Secure 속성)
SESSION_HTTPS_ONLY=false

# ---------- 카카오 로그인 (https://developers.kakao.com) ----------
KAKAO_REST_API_KEY=
# [카카오 로그인 > 보안]에서 Client Secret을 '사용함'으로 설정한 경우에만 입력
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# ---------- 채팅 첨부파일 ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---------- 관리자 ----------
# 최초 관리자: 카카오 회원번호(쉼표 구분). 해당 사용자가 카카오로 로그인하면 관리자 권한이 부여됩니다.
#   회원번호는 관리자 페이지 '로그인' 열 또는 카카오 개발자 콘솔에서 확인
ADMIN_KAKAO_IDS=
# 카카오 없이 로그인하는 기본 관리자 계정(/auth/admin/login). 비워두면 비활성화됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
